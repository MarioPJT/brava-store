VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_WOMPI_CHECKOUT_ENABLED=false

# Optional: address-level reverse geocoding for street and house number.
# Restrict this browser key to BRAVA's allowed domains and the Reverse Geocoding API.
VITE_GEOAPIFY_API_KEY=

# Private payment and notification secrets belong in Supabase Edge Function Secrets,
# never in VITE_* variables or this frontend environment file.
